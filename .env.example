# ── WildTracker – environment variable template ──────────────────────────────
# Copy this file to .env and fill in real values before running locally.
# The .env file is git-ignored and must never be committed.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=wildtracker
POSTGRES_USER=wilduser
POSTGRES_PASSWORD=changeme

# ── API (ASP.NET Core) ────────────────────────────────────────────────────────
# Connection string consumed by the API container (docker-compose injects this).
# For local "dotnet run" outside Docker, set it in Api/appsettings.Development.json instead.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=wildtracker;Username=wilduser;Password=changeme

# ASP.NET Core environment ("Development" enables Scalar/OpenAPI UI and detailed errors)
ASPNETCORE_ENVIRONMENT=Development

# Port the API listens on inside the container (must match docker-compose port mapping)
ASPNETCORE_HTTP_PORTS=5000

# ── Frontend (nginx, production build) ───────────────────────────────────────
# In development the Vite dev server proxies /api → http://localhost:5000.
# No extra variables are needed for the frontend in development mode.
VITE_API_BASE_URL=/api
